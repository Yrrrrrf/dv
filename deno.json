{
  "name": "@yrrrrrf/dv",
  "version": "0.0.5",
  "description": "Commands, composed. A Deno CLI and TypeScript library with a generated npm distribution for Node.",
  "author": "Fernando Bryan Reza Campos <fer.rezac@outlook.com>",
  "readme": "README.md",
  "license": "MIT",
  "imports": { "@deno/dnt": "jsr:@deno/dnt@0.44.0" },
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli/mod.ts"
  },
  "tasks": {
    "dv": "deno run -A src/mod.ts"
  },
  "publish": {
    "include": ["src/", "README.md", "LICENSE", "deno.json", "CHANGELOG.md"]
  },
  "exclude": ["npm/", "dist/"],
  "test": { "exclude": ["test/node/"] }
}
